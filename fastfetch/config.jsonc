{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/Documents/saturn.txt",
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": " -> "
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "green",
                "at": "red",
                "host": "blue"
            }
        },
        "separator",
        "shell",
        "terminal",
        "de",
        "wm",
        "memory",
        "disk",
        "uptime"
    ]
}
